# syntax=docker/dockerfile:1
#
# Release Dockerfile for packyard-server. GoReleaser builds the binary
# ahead of time and this Dockerfile just drops it onto distroless. The
# self-contained build lives in Dockerfile for dev/CI.

FROM gcr.io/distroless/static-debian12:nonroot

# GoReleaser's dockers_v2 lays the binaries out as <os>/<arch>/ in the
# build context; buildx sets TARGETPLATFORM per platform.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/packyard-server /usr/local/bin/packyard-server

USER nonroot:nonroot
# WORKDIR creates directories owned by USER. /backup is the mount point
# for `admin backup -out /backup/...`; owning it lets a named volume
# mounted there start out writable (distroless has no shell to chown).
WORKDIR /backup
WORKDIR /data
# Run from / so the default `-data ./data` resolves to the /data volume
# for the server and for `docker exec … admin …` alike.
WORKDIR /
VOLUME ["/data"]
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/packyard-server"]
